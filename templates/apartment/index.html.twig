<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{{ site_name }}</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }

        header {
            margin-bottom: 20px;
        }

        nav {
            margin-bottom: 30px;
        }

        .search-box {
            padding: 15px;
            background: #f5f5f5;
            border-radius: 6px;
            margin-bottom: 15px;
        }

        .apartment {
            border: 1px solid #ddd;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 6px;
        }

        .price {
            font-weight: bold;
            color: #2c7be5;
        }
    </style>
</head>
<body>

<header>
    <h1>{{ site_name }}</h1>
</header>

<!-- 🔍 WYSZUKIWARKA -->
<section class="search-box">
    <form method="get" action="{{ path('apartment_home') }}">
        <label>
            Maksymalna cena:
            <input
                type="number"
                name="maxPrice"
                min="0"
                value="{{ maxPrice|default(0) }}"
            >
        </label>

        <label>
            Liczba pokoi:
            <input
                type="number"
                name="rooms"
                min="0"
                value="{{ rooms|default(0) }}"
            >
        </label>

        <button type="submit">Szukaj</button>
    </form>
</section>

<!-- 📌 MENU -->
<nav>
    <a href="{{ path('apartment_home') }}">Strona główna</a>
</nav>

<!-- 🏠 LISTA MIESZKAŃ -->
<main>
    {% if apartments is empty %}
        <p>Brak mieszkań spełniających kryteria.</p>
    {% else %}
        {% for apartment in apartments %}
            <div class="apartment">
                <h3>{{ apartment.title }}</h3>

                <p>{{ apartment.description }}</p>

                <p>
                    <span class="price">{{ apartment.price }} PLN</span><br>
                    Pokoje: {{ apartment.rooms }}<br>
                    Metraż: {{ apartment.area }} m²<br>
                    Adres: {{ apartment.address }}
                </p>

                <small>Dodano: {{ apartment.createdAt|date('Y-m-d H:i') }}</small>
            </div>
        {% endfor %}
    {% endif %}
</main>

</body>
</html>
